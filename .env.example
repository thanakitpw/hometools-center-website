# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Resend (for quote/contact notifications)
RESEND_API_KEY=
QUOTE_NOTIFY_EMAIL=

# Line Messaging API (Official Account)
LINE_CHANNEL_ACCESS_TOKEN=
LINE_NOTIFY_USER_ID=

# Site
NEXT_PUBLIC_SITE_URL=https://hometools-center.com

# Analytics / ads — reuse the IDs the WordPress site ran, recovered from its export.
# The container already holds the GA4 + Google Ads (AW-11306253882) tags, so setting
# NEXT_PUBLIC_GTM_ID alone brings conversion tracking and remarketing back.
NEXT_PUBLIC_GTM_ID=GTM-5LCNL8C9
# Loaded directly only when there is no GTM container — kept here for reference.
NEXT_PUBLIC_GA4_ID=G-X9W48F0BWC
NEXT_PUBLIC_CLARITY_ID=
NEXT_PUBLIC_GSC_VERIFICATION=
# Set to 1 ONLY together with a cookie banner — Consent Mode defaults to denied, so
# enabling it without a way to accept keeps Ads conversions dark permanently.
NEXT_PUBLIC_CONSENT_MODE=

# Cloudflare — only needed to run scripts/launch/cloudflare-cutover.js at DNS cutover.
# Scope: Zone -> DNS -> Edit, on hometools-center.com. Revoke once the cutover is done.
CLOUDFLARE_API_TOKEN=
